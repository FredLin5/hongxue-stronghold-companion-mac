<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:ASPAssistant.Mac"
             x:Class="ASPAssistant.Mac.Views.LineupPage">
    <UserControl.Resources>
        <conv:IconPathConverter x:Key="Icon" />
        <conv:IsZeroConverter x:Key="IsZero" />
    </UserControl.Resources>
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="2,2,2,6">
            <Button DockPanel.Dock="Right" Classes="ghost" Content="导入" Click="OnToggleImport" />
            <TextBlock FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center">
                <Run Text="已保存阵容 " /><Run Text="{Binding Lineups.Count}" />
            </TextBlock>
        </DockPanel>

        <Border x:Name="ImportPanel" DockPanel.Dock="Top" Classes="card" Padding="10,8" Margin="0,0,0,8"
                IsVisible="False">
            <StackPanel Spacing="6">
                <TextBlock Text="粘贴森空岛攻略详情链接" FontSize="10"
                           Foreground="{DynamicResource TextMuted}" />
                <TextBox x:Name="ImportBox"
                         Watermark="https://game.skland.com/arknights/stronghold-guide/detail?guideId=…" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="primary" Content="导入阵容" Click="OnImport" />
                    <TextBlock x:Name="ImportStatus" FontSize="10" VerticalAlignment="Center"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" />
                </StackPanel>
                <TextBlock FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}"
                           Text="也可以把 Windows 端 %AppData%\ASPAssistant\lineups 里的 JSON 拷到 ~/Library/Application Support/ASPAssistant/lineups/ 后重启。" />
            </StackPanel>
        </Border>

        <TextBlock DockPanel.Dock="Top" IsVisible="{Binding Lineups.Count, Converter={StaticResource IsZero}}"
                   FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" Margin="2,8,2,0"
                   Text="还没有保存的阵容。点右上角「导入」粘贴森空岛攻略链接，或从 Windows 端复制阵容文件。" />

        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Lineups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="card" Padding="10,8" Margin="0,0,0,8">
                            <StackPanel Spacing="6">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
                                        <Button Classes="ghost" Content="追踪" Click="OnTrackLineup" />
                                        <Button Classes="ghost danger" Content="删除" Click="OnDeleteLineup" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Margin="0,0,8,0" />
                                </DockPanel>
                                <StackPanel Spacing="4" IsVisible="{Binding HasRecommendedStrategies}">
                                    <TextBlock Text="推荐策略" FontSize="10" Foreground="{DynamicResource TextMuted}" />
                                    <ItemsControl ItemsSource="{Binding RecommendedStrategies}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Classes="tag green" ToolTip.Tip="{Binding Tooltip}">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <Image Width="16" Height="16"
                                                               Source="{Binding Strategy.IconPath, Converter={StaticResource Icon}}" />
                                                        <TextBlock Text="{Binding Strategy.Name}" FontSize="10" />
                                                        <TextBlock Text="{Binding TagText}" FontSize="9"
                                                                   Foreground="{DynamicResource TextMuted}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Slots}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SectionBackground}" CornerRadius="6"
                                                    Padding="6,2" Margin="0,0,4,4">
                                                <TextBlock Text="{Binding OperatorName}" FontSize="10"
                                                           Foreground="{DynamicResource TextSecondary}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
