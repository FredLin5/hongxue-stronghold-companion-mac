<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ASPAssistant.Mac.Views.OverlayWindow"
        SystemDecorations="None"
        CanResize="False"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        WindowStartupLocation="Manual"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        Width="800" Height="450">
    <Grid x:Name="Root" Background="Transparent">
        <Border x:Name="Frame" BorderThickness="2" CornerRadius="6"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        <Border x:Name="MarkerTopLeft" Width="40" Height="40"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" />
        <Border x:Name="MarkerTopRight" Width="40" Height="40"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" />
        <Border x:Name="MarkerBottomLeft" Width="40" Height="40"
                HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12" />
        <Border x:Name="MarkerBottomRight" Width="40" Height="40"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12" />
        <Border x:Name="CrossHorizontal" Height="1" HorizontalAlignment="Stretch"
                VerticalAlignment="Center" Background="#553CCFC0" />
        <Border x:Name="CrossVertical" Width="1" VerticalAlignment="Stretch"
                HorizontalAlignment="Center" Background="#553CCFC0" />
        <Canvas x:Name="MarkerLayer" />
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,70" Spacing="4">
            <Border Background="#CC0D1114" BorderThickness="1" CornerRadius="8" Padding="10,4"
                    HorizontalAlignment="Left">
                <TextBlock Text="叠加层测试 · 跟随游戏窗口" FontSize="12" Foreground="#FFE4EAEC" />
            </Border>
            <TextBlock x:Name="StatusText" FontSize="11" Foreground="#CCF2994A" />
        </StackPanel>
    </Grid>
</Window>
