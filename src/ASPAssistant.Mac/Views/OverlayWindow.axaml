<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ASPAssistant.Mac.Views.OverlayWindow"
        SystemDecorations="None"
        CanResize="False"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        WindowStartupLocation="Manual"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        Width="800" Height="450">
    <Grid x:Name="Root" Background="Transparent">
        <Canvas x:Name="MarkerLayer" />
        <TextBlock x:Name="StatusText" FontSize="11" Foreground="#CCF2994A"
                   HorizontalAlignment="Left" VerticalAlignment="Top" Margin="24,24"
                   IsVisible="False" />
    </Grid>
</Window>
