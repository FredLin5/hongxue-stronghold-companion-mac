<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:ASPAssistant.Mac"
             x:Class="ASPAssistant.Mac.Views.OperatorsPage">
    <UserControl.Resources>
        <conv:IconPathConverter x:Key="Icon" />
        <conv:TierRomanConverter x:Key="Tier" />
        <conv:JoinConverter x:Key="Join" />
        <conv:BannedNameConverter x:Key="Banned" />
    </UserControl.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="6">
            <TextBox x:Name="SearchBox" Watermark="搜索干员名称…" Text="{Binding SearchText, Mode=TwoWay}" />
            <ItemsControl ItemsSource="{Binding TierChips}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ToggleButton Classes="chip" Classes.blocked="{Binding IsBlocked}"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Border Width="5" Height="5" CornerRadius="3" VerticalAlignment="Center"
                                        Background="{DynamicResource Accent}" IsVisible="{Binding IsHighlighted}" />
                                <TextBlock Text="{Binding Label}" FontSize="11"
                                           Foreground="{Binding $parent[ToggleButton].Foreground}" />
                            </StackPanel>
                        </ToggleButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="核心" FontSize="10" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMuted}" Margin="0,0,6,0" />
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding CoreChips}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton Classes="chip" Classes.blocked="{Binding IsBlocked}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Border Width="5" Height="5" CornerRadius="3" VerticalAlignment="Center"
                                                Background="{DynamicResource Accent}" IsVisible="{Binding IsHighlighted}" />
                                        <TextBlock Text="{Binding Label}" FontSize="11"
                                                   Foreground="{Binding $parent[ToggleButton].Foreground}" />
                                        <TextBlock Text="{Binding CountText}" FontSize="9" IsVisible="{Binding HasCount}"
                                                   Foreground="{DynamicResource TextMuted}" />
                                    </StackPanel>
                                </ToggleButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="附加" FontSize="10" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMuted}" Margin="0,0,6,0" />
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding OtherChips}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton Classes="chip" Classes.blocked="{Binding IsBlocked}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Border Width="5" Height="5" CornerRadius="3" VerticalAlignment="Center"
                                                Background="{DynamicResource Accent}" IsVisible="{Binding IsHighlighted}" />
                                        <TextBlock Text="{Binding Label}" FontSize="11"
                                                   Foreground="{Binding $parent[ToggleButton].Foreground}" />
                                        <TextBlock Text="{Binding CountText}" FontSize="9" IsVisible="{Binding HasCount}"
                                                   Foreground="{DynamicResource TextMuted}" />
                                    </StackPanel>
                                </ToggleButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
            <DockPanel>
                <Button DockPanel.Dock="Right" Classes="ghost" Content="重置" Click="OnResetFilters" />
                <CheckBox DockPanel.Dock="Right" x:Name="AvailableOnly" Content="只看本局可用" FontSize="10"
                          Margin="0,0,8,0" Click="OnAvailableOnlyToggled" />
                <TextBlock FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center">
                    <Run Text="共 " /><Run Text="{Binding MatchedCount}" /><Run Text=" 名" />
                </TextBlock>
            </DockPanel>
        </StackPanel>

        <ScrollViewer Margin="0,4,0,0">
            <ItemsControl x:Name="OperatorList" ItemsSource="{Binding FilteredOperators}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="row">
                            <Grid ColumnDefinitions="44,*,Auto">
                                <Border Width="40" Height="40" CornerRadius="8" ClipToBounds="True"
                                        Background="{DynamicResource SectionBackground}">
                                    <Image Width="40" Height="40" Stretch="UniformToFill"
                                           Source="{Binding IconPath, Converter={StaticResource Icon}}" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="9,0" VerticalAlignment="Center" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" />
                                        <Border Background="{DynamicResource EliteTint}" CornerRadius="5" Padding="4,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Tier, Converter={StaticResource Tier}}"
                                                       FontSize="10" Foreground="{DynamicResource Elite}" />
                                        </Border>
                                        <Border Background="{DynamicResource DangerTint}" CornerRadius="5" Padding="4,0"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding Name, Converter={StaticResource Banned}}">
                                            <TextBlock Text="本局禁用" FontSize="9" Foreground="{DynamicResource Danger}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondary}"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{Binding CoreCovenants, Converter={StaticResource Join}}" />
                                </StackPanel>
                                <Button Grid.Column="2" Classes="ghost" Content="追踪" Click="OnTrackOperator" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
